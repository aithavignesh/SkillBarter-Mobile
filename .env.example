# SkillBarter Mobile Environment Variables

# Backend API Base URL
# For Android Emulator against local machine: http://10.0.2.2:4000/api/v1
# For iOS Simulator against local machine: http://localhost:4000/api/v1
# For Physical Android/iOS device: http://<YOUR-LOCAL-IP>:4000/api/v1 (e.g. http://192.168.1.100:4000/api/v1)
# For Production / Staging: https://api.skillbarter.com/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Enable/disable debug logs
EXPO_PUBLIC_DEBUG_LOGS=false
