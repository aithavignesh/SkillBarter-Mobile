{
  "expo": {
    "name": "SkillBarter",
    "slug": "skillbarter-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "skillbarter",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skillbarter.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "SkillBarter uses the camera to update your profile photo.",
        "NSPhotoLibraryUsageDescription": "SkillBarter requires access to your photo library to select a profile avatar."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.skillbarter.mobile",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "4df91f19-37b7-421a-9374-5dc72ebe0842"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "vigneshaitha"
  }
}
